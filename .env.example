# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SCHOOL NEWS PLATFORM - ENVIRONMENT CONFIGURATION (PER INSTALLATION)
# ==============================================================================

# SUPABASE CONNECTION (Each school installation has its own Supabase project)
VITE_SUPABASE_URL="https://your-school-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ENVIRONMENT STAGE (development | staging | production)
VITE_APP_ENV="development"

# SERVER-SIDE & TEST SUITE RUNTIME (For Step 07 Test Provisioning & RLS Verification)
# CRITICAL: Never prefix with VITE_. Used exclusively by test execution scripts.
SUPABASE_SERVICE_ROLE_KEY=""

